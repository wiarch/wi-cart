#!/usr/bin/env bash
# wi-cart: arranca API + Flutter en un solo comando.
# Uso: ./dev          (Linux desktop)
#      ./dev web      (Firefox/Chrome si hay)
#      ./dev api      (solo API)
#      ./dev stop     (mata procesos del proyecto)

set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
API_DIR="$ROOT/apps/dev-api"
MOBILE_DIR="$ROOT/apps/mobile"
API_URL="${API_BASE_URL:-http://127.0.0.1:8000}"
API_PORT="${API_PORT:-8000}"
PID_DIR="$ROOT/.dev"
mkdir -p "$PID_DIR"

export PATH="${HOME}/.local/flutter/bin:${HOME}/.local/opt/cmake/bin:${PATH}"

log() { printf '→ %s\n' "$*"; }
die() { printf '✗ %s\n' "$*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "Falta '$1' en PATH"; }

stop_all() {
  if [[ -f "$PID_DIR/api.pid" ]]; then
    kill "$(cat "$PID_DIR/api.pid")" 2>/dev/null || true
    rm -f "$PID_DIR/api.pid"
  fi
  # mata API en el puerto si quedó huérfana
  if command -v fuser >/dev/null 2>&1; then
    fuser -k "${API_PORT}/tcp" 2>/dev/null || true
  elif command -v lsof >/dev/null 2>&1; then
    lsof -ti ":${API_PORT}" | xargs -r kill 2>/dev/null || true
  fi
  pkill -f 'wicart_mobile' 2>/dev/null || true
  log "Detenido."
}

start_api() {
  need node
  need npm
  cd "$API_DIR"
  if [[ ! -d node_modules ]]; then
    log "npm install (API)…"
    npm install --silent
  fi
  # ya corre?
  if curl -sf "http://127.0.0.1:${API_PORT}/" >/dev/null 2>&1; then
    log "API ya en :${API_PORT}"
    return
  fi
  log "API → http://127.0.0.1:${API_PORT}"
  PORT="$API_PORT" nohup node server.js >"$PID_DIR/api.log" 2>&1 &
  echo $! >"$PID_DIR/api.pid"
  for _ in $(seq 1 30); do
    if curl -sf "http://127.0.0.1:${API_PORT}/" >/dev/null 2>&1; then
      log "API OK"
      return
    fi
    sleep 0.2
  done
  die "API no respondió. Ver $PID_DIR/api.log"
}

start_flutter() {
  need flutter
  local target="${1:-linux}"
  cd "$MOBILE_DIR"
  if [[ ! -f .dart_tool/package_config.json ]]; then
    log "flutter pub get…"
    flutter pub get
  fi
  if [[ ! -f lib/data/database.g.dart ]]; then
    log "build_runner (Drift)…"
    dart run build_runner build
  fi

  case "$target" in
    linux)
      need cmake
      log "Flutter Linux → $API_URL"
      exec flutter run -d linux --dart-define="API_BASE_URL=$API_URL"
      ;;
    web)
      export CHROME_EXECUTABLE="${CHROME_EXECUTABLE:-$(command -v google-chrome || command -v chromium || command -v firefox || true)}"
      [[ -n "${CHROME_EXECUTABLE:-}" ]] || die "No hay browser. Exporta CHROME_EXECUTABLE."
      log "Flutter Web → $API_URL"
      exec flutter run -d web-server --web-port=3000 --dart-define="API_BASE_URL=$API_URL"
      ;;
    *)
      die "Target desconocido: $target (linux|web)"
      ;;
  esac
}

cmd="${1:-all}"
case "$cmd" in
  stop) stop_all ;;
  api) start_api; log "Logs: $PID_DIR/api.log"; wait ;;
  linux|all)
    start_api
    start_flutter linux
    ;;
  web)
    start_api
    start_flutter web
    ;;
  -h|--help|help)
    cat <<EOF
wi-cart launcher

  ./dev          API + Flutter Linux
  ./dev web      API + Flutter web-server :3000
  ./dev api      Solo API (foreground wait)
  ./dev stop     Para API/Flutter

Env:
  API_BASE_URL   default http://127.0.0.1:8000
  API_PORT       default 8000
EOF
    ;;
  *) die "Usa: ./dev | ./dev web | ./dev api | ./dev stop" ;;
esac
